# Database connection string
# For SQLite (local dev):
# DATABASE_URL=sqlite+aiosqlite:///./influencer_analytics.db
# For PostgreSQL (production / Railway):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/influencer_db

# YouTube Data API v3
# Get your key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Scheduler settings
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=24

# Sentiment analysis (downloads ~250MB model on first run)
SENTIMENT_ENABLED=true

# API settings
API_HOST=0.0.0.0
API_PORT=8000
